<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.secretchat.client.ui.ChatController">
  <padding><Insets top="12" left="12" right="12" bottom="12"/></padding>
  <top>
    <HBox spacing="14">
      <Label fx:id="title" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
      <Label fx:id="countdown"/>
      <Label fx:id="connection"/>
    </HBox>
  </top>
  <center>
    <ListView fx:id="messages"/>
  </center>
  <right>
    <VBox spacing="6" prefWidth="220">
      <padding><Insets left="12"/></padding>
      <Label text="Members"/>
      <ListView fx:id="members" VBox.vgrow="ALWAYS"/>
      <Button fx:id="resetButton" text="Reset room now" visible="false" onAction="#onReset"/>
      <Button text="Leave" onAction="#onLeave"/>
      <Button text="Reconnect" onAction="#onReconnect"/>
    </VBox>
  </right>
  <bottom>
    <HBox spacing="8">
      <padding><Insets top="8"/></padding>
      <TextField fx:id="input" HBox.hgrow="ALWAYS" promptText="Type a message" onAction="#onSend"/>
      <Button text="Send" defaultButton="true" onAction="#onSend"/>
    </HBox>
  </bottom>
</BorderPane>
